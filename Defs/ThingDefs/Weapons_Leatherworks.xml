<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ===== Leather Sling ===== -->

  <ThingDef ParentName="BaseWeaponNeolithic">
    <defName>LW_Weapon_LeatherSling</defName>
    <label>leather sling</label>
    <description>A simple woven leather pouch on cords, used to whirl and launch smooth stones at high speed. It deals blunt impact damage to targets.</description>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponRanged/LeatherSling</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <soundInteract>Bow_Small</soundInteract>
    <costStuffCount>20</costStuffCount>
    <stuffCategories>
      <li>Leathery</li>
    </stuffCategories>
    <statBases>
      <WorkToMake>1600</WorkToMake>
      <Mass>0.3</Mass>
      <AccuracyTouch>0.70</AccuracyTouch>
      <AccuracyShort>0.65</AccuracyShort>
      <AccuracyMedium>0.45</AccuracyMedium>
      <AccuracyLong>0.20</AccuracyLong>
      <RangedWeapon_Cooldown>1.4</RangedWeapon_Cooldown>
    </statBases>
    <weaponTags>
      <li>NeolithicRangedBasic</li>
    </weaponTags>
    <weaponClasses>
      <li>Ranged</li>
      <li>RangedLight</li>
      <li>Neolithic</li>
    </weaponClasses>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Tailor</effectWorking>
      <soundWorking>Recipe_Tailor</soundWorking>
      <recipeUsers>
        <li>CraftingSpot</li>
        <li>HandTailoringBench</li>
        <li>ElectricTailoringBench</li>
      </recipeUsers>
      <unfinishedThingDef>UnfinishedWeapon</unfinishedThingDef>
      <skillRequirements>
        <Crafting>2</Crafting>
      </skillRequirements>
      <displayPriority>505</displayPriority>
    </recipeMaker>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>LW_Bullet_SlingStone</defaultProjectile>
        <warmupTime>1.2</warmupTime>
        <range>20.9</range>
        <soundCast>Interact_BeatFire</soundCast>
        <rangedFireRulepack>Combat_RangedFire_Thrown</rangedFireRulepack>
      </li>
    </verbs>
    <tools>
      <li>
        <label>cradle</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>6</power>
        <cooldownTime>1.8</cooldownTime>
      </li>
    </tools>
  </ThingDef>

  <!-- ===== Sling Projectile ===== -->

  <ThingDef ParentName="BaseProjectileNeolithic">
    <defName>LW_Bullet_SlingStone</defName>
    <label>sling stone</label>
    <graphicData>
      <texPath>Things/Projectile/SlingStone</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>Blunt</damageDef>
      <damageAmountBase>9</damageAmountBase>
      <stoppingPower>1.0</stoppingPower>
      <armorPenetrationBase>0.05</armorPenetrationBase>
      <speed>38</speed>
    </projectile>
  </ThingDef>

</Defs>
