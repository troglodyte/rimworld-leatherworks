  <ThingDef ParentName="LW_PaddedArmorBase">
    <defName>LW_Apparel_PaddedJerkin</defName>
    <label>padded jerkin</label>
    <description>A quilted jacket of thick fabric padded and reinforced with leather. Excellent protection against blunt impacts and cold weather, though less effective against sharp blades than solid leather.</description>
    <techLevel>Neolithic</techLevel>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/FlakVest/FlakVest</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.90</drawSize>
    </graphicData>
    <costStuffCount>50</costStuffCount>
    <costList>
      <Leather_Plain>20</Leather_Plain>
    </costList>
    <statBases>
      <MaxHitPoints>160</MaxHitPoints>
      <Mass>2.0</Mass>
      <EquipDelay>2.5</EquipDelay>
      <ArmorRating_Blunt>0.20</ArmorRating_Blunt>
      <StuffEffectMultiplierArmor>0.35</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>0.75</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0.20</StuffEffectMultiplierInsulation_Heat>
      <WorkToMake>5000</WorkToMake>
    </statBases>
    <comps>
      <li Class="Leatherworks.CompProperties_PaddedLeather" />
    </comps>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Arms</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/FlakVest/FlakVest</wornGraphicPath>
      <layers>
        <li>Middle</li>
      </layers>
      <tags>
        <li>Neolithic</li>
      </tags>
    </apparel>
  </ThingDef>

  <ThingDef ParentName="LW_PaddedArmorBase">
    <defName>LW_Apparel_PaddedCap</defName>
    <label>padded cap</label>
